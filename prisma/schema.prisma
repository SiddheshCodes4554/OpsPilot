// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN       // Full access
  MANAGER     // Partial admin access
  STAFF       // Standard operations
  AI_AGENT    // Dedicated role for autonomous agent executors
}

enum OrderStatus {
  PENDING     // Received but not processed
  PROCESSING  // In progress
  SHIPPED     // Dispatched
  DELIVERED   // Handled successfully
  CANCELLED   // Abandoned
  REFUNDED    // Returned
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ORDERED
  DELIVERED
  RECEIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailStatus {
  DRAFT
  SENT
  FAILED
  RECEIVED
}

enum EmailPriority {
  LOW
  MEDIUM
  HIGH
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

// ==========================================
// MODELS
// ==========================================

/// Users who manage and operate the OpsPilot AI workspace.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      UserRole @default(STAFF)
  clerkId   String?  @unique // Maps to Clerk Auth profile ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  orders         Order[]         // Orders created/processed by this user
  purchaseOrders PurchaseOrder[] // Purchase orders raised by this user
  approvals      Approval[]      // Approval workflows handled by this user
  agentLogs      AgentLog[]      // Execution logs generated by this user if they are an AI_AGENT
  notifications  Notification[]  // Notifications sent to this user

  @@map("users")
}

/// CRM Customer contacts who purchase products and place orders.
model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  orders Order[] // Customer orders history
  emails Email[] // Communications sent to/from this customer

  @@map("customers")
}

/// Catalog of items sold.
model Product {
  id          String   @id @default(uuid())
  sku         String   @unique // Stock Keeping Unit code
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2) // Precision financial price
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  inventory          Inventory?          // One-to-One connection with product stock metrics
  orderItems         OrderItem[]         // Link to orders containing this product
  purchaseOrderItems PurchaseOrderItem[] // Link to supplier purchase orders containing this product
  supplierId         String?             // Primary supplier reference
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@map("products")
}

/// Product stock details.
/// This maintains a One-to-One relationship with the Product model.
model Inventory {
  id            String   @id @default(uuid())
  productId     String   @unique // Foreign key to Product (Must be unique for 1-to-1)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int      @default(0) // Available quantity on hand
  location      String?  // Storage shelf or warehouse aisle details
  minStockLevel Int      @default(10) // Low stock threshold value
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("inventories")
}

/// Sales orders placed by Customers.
/// This model maintains a One-to-Many relationship with Customer,
/// and a One-to-Many relationship with User (handling agent/staff).
model Order {
  id          String      @id @default(uuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  userId      String?     // Associated agent or employee
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relationships
  items     OrderItem[] // Items included in this order
  approvals Approval[]  // Associated approvals if values exceed limit

  @@map("orders")
}

/// OrderItem - Normalized Join table representing items within a customer order.
/// Resolves many-to-many relationship between Orders and Products.
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) // Price at the time of order purchase

  @@map("order_items")
}

/// Suppliers providing raw materials or products.
model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  email       String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  purchaseOrders PurchaseOrder[] // Procurement history raised with this supplier
  products       Product[]       // Products supplied by this supplier

  @@map("suppliers")
}

/// Purchase orders issued to Suppliers for replenishment.
/// Maintains One-to-Many relationships with Supplier and User (buyer).
model PurchaseOrder {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  userId      String?             // Staff member initiating the request
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      PurchaseOrderStatus @default(PENDING)
  totalAmount Decimal             @db.Decimal(10, 2)
  eta         DateTime?           // Estimated Time of Arrival
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relationships
  items     PurchaseOrderItem[] // Replenishment items
  approvals Approval[]          // Approvals workflow details

  @@map("purchase_orders")
}

/// PurchaseOrderItem - Normalized Join table representing products on a Purchase Order.
/// Resolves many-to-many relationship between Purchase Orders and Products.
model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2) // Quoted unit cost

  @@map("purchase_order_items")
}

/// Emails processed or archived inside the CRM environment.
/// Optional relationship back to Customer contacts.
model Email {
  id         String      @id @default(uuid())
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subject    String
  body       String      @db.Text
  status     EmailStatus   @default(RECEIVED)
  priority   EmailPriority @default(MEDIUM)
  sender     String      // Source email address
  recipient  String      // Target email address
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("emails")
}

/// Notifications sent to workspace Users.
model Notification {
  id        String   @id @default(uuid())
  userId    String?  // Recipient user account (Null implies workspace-wide broadcast)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

/// Approval workflow records.
/// Linked optionally to Order or PurchaseOrder, requiring action from a designated approver.
model Approval {
  id              String         @id @default(uuid())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approverId      String?
  approver        User?          @relation(fields: [approverId], references: [id], onDelete: SetNull)
  status          ApprovalStatus @default(PENDING)
  comments        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("approvals")
}

/// Operational activity traces for AI Agents.
/// Links back to the User (with AI_AGENT role).
model AgentLog {
  id        String   @id @default(uuid())
  agentId   String?  // Links log to the executing Agent user profile
  agent     User?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  action    String   // Description of the action (e.g., "Draft Response")
  level     LogLevel @default(INFO)
  message   String   @db.Text
  metadata  String?  // JSON-serialized string detailing additional context
  createdAt DateTime @default(now())

  @@map("agent_logs")
}
